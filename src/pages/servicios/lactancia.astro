---
import ServiceDetail from "@/components/ui/ServiceDetail.astro"
import { SERVICES } from "@/data/services"

export const prerender = true

const service = SERVICES.lactancia
const motif = "/images/icons/illustrations/ilustracion-negro_05.svg"

const aboutBody = [
	"Una asesora de lactancia te acompaña de forma individual para que la lactancia materna sea una experiencia tranquila y posible, desde el inicio hasta cualquier etapa del proceso. Es un espacio seguro donde expresar tus dudas, recibir apoyo profesional y encontrar soluciones adaptadas a tu situación.",
	"En Femm tribu la asesoría la lleva María Belenguer, matrona y especialista en lactancia, así que al acompañamiento se suma la valoración sanitaria de ti y de tu bebé.",
	"En la asesoría de lactancia valoramos la toma completa y el agarre del bebé, abordamos el dolor, las grietas o las molestias, y trabajamos la producción de leche, el uso del sacaleches, la lactancia mixta o diferida, la vuelta al trabajo y el destete respetuoso. Cada caso es único y la consulta se adapta a ti.",
	"Puedes reservar tu asesora de lactancia online o presencial en Valencia, en una sesión de 60 minutos.",
]

const work = [
	"Valoración completa de la toma",
	"Evaluación del agarre del bebé",
	"Dolor, grietas o molestias",
	"Producción de leche (aumento o disminución)",
	"Uso de sacaleches",
	"Lactancia mixta o diferida",
	"Vuelta al trabajo",
	"Destete respetuoso",
]

const audience = [
	"Madres recientes",
	"Embarazadas que quieren prepararse",
	"Mujeres con dificultades en la lactancia",
	"Cualquier mamá que necesite acompañamiento",
]

const faqs = [
	{
		question: "¿Qué hace una asesora de lactancia?",
		answer:
			"Una asesora de lactancia valora la toma y el agarre del bebé, identifica la causa de las dificultades (dolor, grietas, poca ganancia de peso, baja producción) y te da pautas concretas para amamantar sin molestias. También acompaña el uso del sacaleches, la lactancia mixta, la vuelta al trabajo y el destete respetuoso.",
	},
	{
		question: "¿Cuánto cuesta una asesora de lactancia en Valencia?",
		answer:
			"La asesoría de lactancia cuesta 50 € e incluye 60 minutos de atención personalizada, online o presencial en Valencia.",
	},
	{
		question: "¿Qué diferencia hay entre una asesora de lactancia y una matrona?",
		answer:
			"Una asesora de lactancia está formada específicamente en lactancia materna y acompaña el proceso. Una matrona es además profesional sanitaria y puede valorar tu salud y la del bebé. Aquí tienes las dos cosas: María es matrona y especialista en lactancia, así que la asesoría incluye valoración sanitaria.",
	},
	{
		question: "¿Qué incluye la asesoría de lactancia con matrona?",
		answer:
			"Incluye la valoración de la toma y del agarre, el abordaje del dolor o las grietas, y el trabajo sobre producción de leche, sacaleches, lactancia mixta, vuelta al trabajo o destete, según lo que necesites. Dura 60 minutos y te llevas pautas por escrito.",
	},
	{
		question: "¿Es mejor la asesoría de lactancia online o presencial?",
		answer:
			"Ambas son eficaces. La presencial en Valencia permite valorar la toma en directo; la online es muy cómoda y resuelve la gran mayoría de dificultades con apoyo visual. Te ayudo a elegir según tu caso.",
	},
	{
		question: "¿A partir de cuándo puedo pedir cita con la asesora de lactancia?",
		answer:
			"Cuando quieras: durante el embarazo para prepararte, en los primeros días si surge cualquier dificultad, o más adelante para la vuelta al trabajo o el destete.",
	},
	{
		question: "¿Atendéis el dolor al amamantar o los problemas de agarre?",
		answer:
			"Sí, son de los motivos de consulta más frecuentes. Valoramos la causa del dolor o del mal agarre y te damos pautas concretas para corregirlo y amamantar sin molestias.",
	},
	{
		question: "¿Ofrecéis packs de seguimiento de lactancia?",
		answer:
			"Ahora el servicio es una consulta única de 50 € que se adapta a cada etapa, con seguimiento posterior por WhatsApp cuando lo necesitas. Si requieres acompañamiento continuado, planificamos juntas las sesiones que precises.",
	},
]

const related = [
	{
		href: "/servicios/preparacion-al-parto",
		title: "Preparación al Parto",
		description: "Prepara el inicio de la lactancia y el posparto antes del nacimiento.",
		price: "50€ · 60 min",
	},
	{
		href: "/servicios/pendientes-bebe",
		title: "Pendientes para Bebés",
		description: "Colocación de pendientes por matrona profesional, en Valencia.",
		price: "60€",
	},
]
---

<ServiceDetail
	service={service}
	serviceName="Lactancia"
	color="sage"
	motif={motif}
	eyebrow="Acompañamiento personalizado"
	h1Accent="Asesora de Lactancia"
	h1Tail="en Valencia y Online"
	intro="Asesora de lactancia y matrona en Valencia y online, para que disfrutes de tu lactancia. Resolvemos tus dudas, superamos dificultades y te sostenemos en cada etapa, desde el inicio hasta el destete respetuoso."
	aboutTitle="¿Qué hace una asesora de lactancia?"
	aboutBody={aboutBody}
	workTitle="¿Qué trabajamos en la asesoría de lactancia?"
	work={work}
	audienceTitle="¿Para quién es la asesoría de lactancia?"
	audience={audience}
	priceNote="60 min · Online o presencial · Sesión personalizada"
	faqTitle="Preguntas frecuentes sobre la asesoría de lactancia"
	faqs={faqs}
	related={related}
/>
